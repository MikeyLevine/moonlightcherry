# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
# (Prisma's CLI only reads .env, not .env.local, so this project uses .env.)

# Postgres connection string. Matches docker-compose.yml's default service
# if you're running the bundled local Postgres container.
DATABASE_URL="postgresql://moonlightcherry:moonlightcherry_dev@localhost:5432/moonlightcherry"

# Only read by deploy/backup.sh (which database to dump) and
# docker-compose.yml (which password to set) — must match the database name
# and password embedded in DATABASE_URL above. Production uses its own
# database name here (e.g. moonlightcherry_prod), never dev's.
POSTGRES_DB="moonlightcherry"
POSTGRES_PASSWORD="moonlightcherry_dev"

# Auth.js session/cookie signing secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"

# Required in production (behind Caddy/any reverse proxy) — trustHost's
# header-based inference alone isn't reliable enough there in practice, per
# Auth.js's own deployment docs: the app was generating OAuth callback URLs
# pointing at its internal localhost:PORT bind address instead of the public
# domain until this was set explicitly, found by testing a real production
# deploy, not assumed. Not needed in dev (next dev binds directly to
# dev.moonlightcherry.xyz, so header inference is a non-issue there).
# AUTH_URL="https://moonlightcherry.xyz/auth"

# Discord OAuth app credentials (Discord Developer Portal -> Applications -> OAuth2)
AUTH_DISCORD_ID="replace-with-discord-client-id"
AUTH_DISCORD_SECRET="replace-with-discord-client-secret"

# Google OAuth app credentials (Google Cloud Console -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# Where processed media files live on disk. In production this should point
# outside the app directory (e.g. /srv/moonlightcherry/media) so it survives
# deploys.
MEDIA_STORAGE_DIR="./storage/media"

# Canonical site URL (no trailing slash) — used for absolute URLs in Open
# Graph tags, sitemap.xml, and robots.txt. Production: https://moonlightcherry.xyz
# Dev: http://dev.moonlightcherry.xyz:3000
SITE_URL="https://moonlightcherry.xyz"

# Optional. Cloudflare Turnstile (Cloudflare dashboard -> Turnstile -> Add site,
# same account as the domain's DNS). Bot-check on upload. Leave both unset to
# ship with Turnstile disabled (src/lib/security/turnstile.ts no-ops without
# a secret) — nothing else needs to change when you add real keys later.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="replace-with-turnstile-site-key"
# TURNSTILE_SECRET_KEY="replace-with-turnstile-secret-key"
